PATHOVISION_STORAGE=./runtime
PATHOVISION_MAX_UPLOAD_GB=8
PATHOVISION_API_HOST=0.0.0.0
PATHOVISION_API_PORT=8000
PATHOVISION_FRONTEND_ORIGIN=http://localhost:5173

PATHOVISION_DATABASE_URL=postgresql+psycopg://pathovision:pathovision@localhost:5432/pathovision
PATHOVISION_CELERY_BROKER_URL=amqp://pathovision:pathovision@localhost:5672/pathovision
PATHOVISION_CELERY_QUEUE=analysis
PATHOVISION_REDIS_URL=redis://localhost:6379/0

PATHOVISION_AUTH_REQUIRED=false
PATHOVISION_JWT_SECRET=replace-with-a-long-random-secret
PATHOVISION_ACCESS_TOKEN_EXPIRE_MINUTES=60
PATHOVISION_BOOTSTRAP_USERNAME=admin
PATHOVISION_BOOTSTRAP_PASSWORD=change-me-strong-password

PATHOVISION_CLASSIFIER_CHECKPOINT=checkpoints/best_resnet18.pt
PATHOVISION_UNET_CHECKPOINT=checkpoints/best_unet.pt
PATHOVISION_TILE_SIZE=256
PATHOVISION_MIN_TISSUE=0.25
PATHOVISION_CLASSIFIER_BATCH=32
PATHOVISION_SEGMENTATION_BATCH=4

PATHOVISION_OBJECT_STORE_ENABLED=false
PATHOVISION_OBJECT_STORE_ENDPOINT=http://localhost:9000
PATHOVISION_OBJECT_STORE_BUCKET=pathovision-artifacts
PATHOVISION_OBJECT_STORE_REGION=us-east-1
PATHOVISION_OBJECT_STORE_ACCESS_KEY=pathovision
PATHOVISION_OBJECT_STORE_SECRET_KEY=replace-me

PATHOVISION_RATE_LIMIT_PER_MINUTE=120
PATHOVISION_ANALYZE_RATE_LIMIT_PER_MINUTE=10
PATHOVISION_LOGIN_RATE_LIMIT_PER_MINUTE=12
PATHOVISION_REGISTER_RATE_LIMIT_PER_MINUTE=6
PATHOVISION_IDEMPOTENCY_TTL_SECONDS=86400
CELERY_LOG_LEVEL=INFO
